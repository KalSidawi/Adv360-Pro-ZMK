// --- TAP-DANCES: SKETCHER DOMAIN ---
td_fc_line: td_fc_line {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&mac_fc_line>, <&mac_fc_poly>;
};

td_fc_rect: td_fc_rect {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&mac_fc_rect>, <&mac_fc_slot>;
};

td_fc_circ: td_fc_circ {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&mac_fc_circ>, <&mac_fc_arc>;
};

td_fc_trim: td_fc_trim {
    compatible = "zmk,behavior-tap-dance";
