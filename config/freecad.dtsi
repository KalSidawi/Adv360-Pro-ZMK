// ══════════════════════════════════════════════════════════════════════════════
// TAP-DANCE DEFINITIONS
// ══════════════════════════════════════════════════════════════════════════════

// --- TAP-DANCES: SKETCHER DOMAIN ---
line_polyline: line_polyline {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&line>, <&polyline>;
};

rectang_slot: rectang_slot {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&rectangle>, <&slot>;
};

circle_arc: circle_arc {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&circle>, <&arc>;
};

trim_point: trim_point {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&trim_edge>, <&point>;
};

prject_constr: prject_constr {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <250>;
    bindings = <&ext_geo>, <&construct>;
};

