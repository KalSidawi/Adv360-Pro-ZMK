// ══════════════════════════════════════════════════════════════════════════════
// FREECAD MACROS & TAP-DANCES
// ══════════════════════════════════════════════════════════════════════════════

// --- MACROS: SKETCHER DOMAIN ---
line: line {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <30>;
    bindings = <&kp G>, <&kp L>;
};

polyline: polyline {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <30>;
    bindings = <&kp G>, <&kp M>;
};

rectangle: rectangle {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <30>;
    bindings = <&kp G>, <&kp R>;
};

