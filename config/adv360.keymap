      bindings = <
        &trans &td_lin_polar &td_fill_cham &trans &trans &trans &trans                                                    &trans &trans &trans &trans &trans &trans &trans
        &trans &td_mir_trans &trans &td_rev_groov &td_pad_pock &td_sketch &tog CAD                                        &trans &trans &trans &trans &trans &trans &trans
        &trans &td_trim_pt &td_circ_arc &td_rect_slot &td_line_poly &td_prjct_const &trans       &trans &trans    &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                                &mo CONSTRAINTS &mo CONSTRAINTS                  &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans                             &trans &trans &trans  &trans &trans &trans                        &trans &trans &trans &trans &trans
      >;
    };

    Placeholder2 {
      display-name = "Constraints";
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                                                          ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
