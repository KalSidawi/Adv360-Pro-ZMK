// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  VISUAL HELPER TABLES: Each layer has an ASCII art comment block       ║
// ║  above its bindings that mirrors the physical key layout.              ║
// ║                                                                        ║
// ║  RULE: When editing ANY layer's bindings, the corresponding ASCII      ║
// ║  table comment MUST be updated to reflect the change. NEVER strip      ║
// ║  these comments. They are the human-readable source of truth.          ║
// ╚══════════════════════════════════════════════════════════════════════════╝

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define P1 1
#define VSC 2
#define KICAD 3
#define CAD 4
#define CONSTRAINTS 5
#define WIKI 6
#define KP 7
#define SYM 8
#define FN 9
#define MOD 10

/ {
    behaviors {
      #include "version.dtsi"
      #include "macros.dtsi"
      #include "freecad.dtsi"
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                                                          ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │  &kp GRAVE   │    &kp N1    │    &kp N2    │    &kp N3    │    &kp N4    │    &kp N5    │   &tog KP    │                                                                          │   &mo MOD    │    &kp N6    │    &kp N7    │    &kp N8    │    &kp N9    │    &kp N0    │  &kp MINUS   │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                                                                          ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │  &kp EQUAL   │    &kp Q     │    &kp W     │    &kp E     │    &kp R     │    &kp T     │   &tog CAD   │                                                                          │  &kp INSERT  │    &kp Y     │    &kp U     │    &kp I     │    &kp O     │    &kp P     │   &kp BSLH   │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ┌──────────────┬──────────────┐┌───────────────┬──────────────┐        ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │   &kp TAB    │    &kp A     │    &kp S     │    &kp D     │    &kp F     │  &lt SYM G   │   &kp LGUI   │   │  &kp LSHFT   │  &kp LCTRL   ││   &kp RCTRL   │  &kp RSHFT   │        │   &kp RGUI   │  &lt SYM H   │    &kp J     │    &kp K     │    &kp L     │   &kp SEMI   │   &kp SQT    │
      // │              │              │              │              │              │              │              │   │              │              ││               │              │        │              │              │              │              │              │              │              │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘   └──────────────┼──────────────┤├───────────────┼──────────────┘        └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │  &kp LSHFT   │    &kp Z     │    &kp X     │    &kp C     │    &kp V     │    &kp B     │                                 │   &kp LALT   ││   &kp RALT    │                                      │    &kp N     │    &kp M     │  &kp COMMA   │   &kp DOT    │   &kp FSLH   │  &kp RSHFT   │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘ ┌────────────────┬──────────────┼──────────────┤├───────────────┼──────────────┬───────────┐           └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &mo FN    │   &kp HOME   │   &kp CAPS   │   &kp LEFT   │  &kp RIGHT   │                │   &kp DELETE   │  &kp ENTER   │   &kp ESC    ││    &kp ESC    │  &kp SPACE   │ &kp BSPC  │                          │    &kp UP    │   &kp DOWN   │   &kp LBKT   │   &kp RBKT   │    &mo FN    │
      // └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                └────────────────┴──────────────┴──────────────┘└───────────────┴──────────────┴───────────┘                          └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      bindings = <
        &kp GRAVE &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog KP                                                       &mo MOD    &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp EQUAL &kp Q     &kp W    &kp E    &kp R      &kp T  &tog CAD                                                       &kp INSERT &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp TAB   &kp A     &kp S    &kp D    &kp F  &lt SYM G  &kp LGUI        &kp LSHFT    &kp LCTRL  &kp RCTRL &kp RSHFT   &kp RGUI   &lt SYM H &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                               &kp LALT  &kp RALT                        &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp HOME  &kp CAPS &kp LEFT &kp RIGHT                &kp DELETE  &kp ENTER &kp ESC    &kp ESC   &kp SPACE  &kp BSPC         &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN
      >;
    };

    Placeholder1 {
      display-name = "P1";
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                                                          ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                                                                          ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ┌──────────────┬──────────────┐┌───────────────┬──────────────┐        ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │   │    &trans    │    &trans    ││    &trans     │    &trans    │        │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // │              │              │              │              │              │              │              │   │              │              ││               │              │        │              │              │              │              │              │              │              │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘   └──────────────┼──────────────┤├───────────────┼──────────────┘        └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                 │    &trans    ││    &trans     │                                      │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘ ┌────────────────┬──────────────┼──────────────┤├───────────────┼──────────────┬───────────┐           └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                │     &trans     │    &trans    │    &trans    ││    &trans     │    &trans    │  &trans   │                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                └────────────────┴──────────────┴──────────────┘└───────────────┴──────────────┴───────────┘                          └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                          &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans                                           &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans        &trans &trans &trans       &trans &trans &trans        &trans &trans &trans &trans &trans
      >;
    };

    VisualStudioCode {
      display-name = "VSCode";
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                                                          ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                                                                          ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ┌──────────────┬──────────────┐┌───────────────┬──────────────┐        ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │   │    &trans    │    &trans    ││    &trans     │    &trans    │        │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // │              │              │              │              │              │              │              │   │              │              ││               │              │        │              │              │              │              │              │              │              │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘   └──────────────┼──────────────┤├───────────────┼──────────────┘        └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                 │    &trans    ││    &trans     │                                      │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘ ┌────────────────┬──────────────┼──────────────┤├───────────────┼──────────────┬───────────┐           └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                │     &trans     │    &trans    │    &trans    ││    &trans     │    &trans    │  &trans   │                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                └────────────────┴──────────────┴──────────────┘└───────────────┴──────────────┴───────────┘                          └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                          &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans                                           &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans        &trans &trans &trans       &trans &trans &trans        &trans &trans &trans &trans &trans
      >;
    };

    KiCAD {
      display-name = "KiCAD9";
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                                                          ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                                                                          ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                                                          │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ┌──────────────┬──────────────┐┌───────────────┬──────────────┐        ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │   │    &trans    │    &trans    ││    &trans     │    &trans    │        │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
      // │              │              │              │              │              │              │              │   │              │              ││               │              │        │              │              │              │              │              │              │              │
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┘   └──────────────┼──────────────┤├───────────────┼──────────────┘        └──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │                                 │    &trans    ││    &trans     │                                      │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │    &trans    │
